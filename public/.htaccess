# Generated by scripts/make_htaccess.py. Do not edit by hand.
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Old WordPress URLs
RedirectMatch 301 ^/gtm-engineering-plan/?$ /services/ai-outbound-engineering/
RedirectMatch 301 ^/gtm-engineering/?$ /services/ai-outbound-engineering/
RedirectMatch 301 ^/fractional-cmo-plans/?$ /services/
RedirectMatch 301 ^/our-plans/?$ /services/
RedirectMatch 301 ^/guest-posting-services/?$ /services/
RedirectMatch 301 ^/order-guest-posts/?$ /services/
RedirectMatch 301 ^/hire-our-growth-team/?$ /book-a-call/
RedirectMatch 301 ^/our-work/?$ /case-studies/
RedirectMatch 301 ^/portfolio/?$ /case-studies/
RedirectMatch 301 ^/portfolio/life-science-saas-use-case/?$ /case-studies/healthtech-ai-saas-outbound/
RedirectMatch 301 ^/portfolio/lullify/?$ /case-studies/lullify/
RedirectMatch 301 ^/portfolio/ugonnafish/?$ /case-studies/ugonnafish/
RedirectMatch 301 ^/portfolio/esler/?$ /case-studies/esler/
RedirectMatch 301 ^/portfolio/visa-pathway/?$ /case-studies/visa-pathway/
RedirectMatch 301 ^/about-get-to-revenue/?$ /about/
RedirectMatch 301 ^/careers/?$ /about/
RedirectMatch 301 ^/privacy-policy/?$ /privacy/
RedirectMatch 301 ^/sitemap_html/?$ /
RedirectMatch 301 ^/what-is-growth-marketing/?$ /blog/what-is-growth-marketing/
RedirectMatch 301 ^/how-to-get-started-in-growth-marketing/?$ /blog/how-to-get-started-in-growth-marketing/
RedirectMatch 301 ^/fractional-marketing-manager-vs-in-house-marketing-manager/?$ /blog/fractional-marketing-manager-vs-in-house-marketing-manager/
RedirectMatch 301 ^/the-cost-effectiveness-of-hiring-a-growth-marketing-team/?$ /blog/the-cost-effectiveness-of-hiring-a-growth-marketing-team/
RedirectMatch 301 ^/podcast-on-fractional-cmo-insights-and-go-to-market-strategies/?$ /blog/podcast-on-fractional-cmo-insights-and-go-to-market-strategies/
RedirectMatch 301 ^/feed/?$ /feed.xml
RedirectMatch 301 ^/wp-sitemap.xml/?$ /sitemap.xml

# WordPress taxonomy archives
RedirectMatch 301 ^/(category|tag)/.*$ /blog/

ErrorDocument 404 /404.html
